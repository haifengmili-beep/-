[
 {
  "text": "假如你家猫踩奶的频率，每分钟翻一倍。",
  "file": "/home/user/-/double_knead/vo/line0.wav",
  "dur": 3.0650340136054424
 },
 {
  "text": "加班到深夜，回到家，往沙发上一躺。",
  "file": "/home/user/-/double_knead/vo/line1.wav",
  "dur": 3.040612244897959
 },
 {
  "text": "第一分钟，它踩了一下。好治愈。",
  "file": "/home/user/-/double_knead/vo/line2.wav",
  "dur": 2.4367573696145124
 },
 {
  "text": "第五分钟，十六下，像在做按摩。",
  "file": "/home/user/-/double_knead/vo/line3.wav",
  "dur": 2.8792743764172335
 },
 {
  "text": "第十分钟，五百一十二下，爪子已经看不清了。",
  "file": "/home/user/-/double_knead/vo/line4.wav",
  "dur": 3.564263038548753
 },
 {
  "text": "第十五分钟，一万六千多下，沙发开始冒烟。",
  "file": "/home/user/-/double_knead/vo/line5.wav",
  "dur": 3.7035827664399092
 },
 {
  "text": "第二十分钟，五十二万下，整栋楼都在震，邻居报警了。",
  "file": "/home/user/-/double_knead/vo/line6.wav",
  "dur": 4.46984126984127
 },
 {
  "text": "第三十分钟，五亿多下，你被踩进了地心。",
  "file": "/home/user/-/double_knead/vo/line7.wav",
  "dur": 3.2856235827664397
 },
 {
  "text": "第三十一分钟，它踩累了，打了个哈欠，睡着了。",
  "file": "/home/user/-/double_knead/vo/line8.wav",
  "dur": 3.8811791383219956
 },
 {
  "text": "而你，明早九点，还要打卡。",
  "file": "/home/user/-/double_knead/vo/line9.wav",
  "dur": 2.1129251700680274
 }
]