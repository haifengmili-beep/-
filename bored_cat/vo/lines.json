[
 {
  "text": "你出门上班的时候，猫在家，会不会很无聊？",
  "file": "line0.wav",
  "dur": 3.508185941043084
 },
 {
  "text": "其实猫一天要睡十二到十六个小时，你不在，它大半时间都在呼呼大睡。",
  "file": "line1.wav",
  "dur": 5.804988662131519
 },
 {
  "text": "但要是天天一走就是一整天，它也会闷得发慌。",
  "file": "line2.wav",
  "dur": 3.575873015873016
 },
 {
  "text": "无聊的猫，会乱抓沙发，半夜跑酷，还会追着你喵喵叫。",
  "file": "line3.wav",
  "dur": 4.6788208616780045
 },
 {
  "text": "出门前陪它玩十分钟，把猫爬架放在窗边，再藏几颗零食。",
  "file": "line4.wav",
  "dur": 4.934240362811791
 },
 {
  "text": "这样等你回家，它才会精神满满地，冲过来迎接你。",
  "file": "line5.wav",
  "dur": 4.051882086167801
 }
]