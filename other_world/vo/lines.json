[
 {
  "text": "嘿，是我呀。我在这边，过得很好。",
  "file": "line0.wav",
  "dur": 3.233922902494331
 },
 {
  "text": "这里的阳光，每天都晒在我最喜欢的地方。",
  "file": "line1.wav",
  "dur": 3.7268027210884354
 },
 {
  "text": "罐头吃不完，身上，也再也不疼了。",
  "file": "line2.wav",
  "dur": 3.0882539682539685
 },
 {
  "text": "别总盯着我的空碗发呆啦。",
  "file": "line3.wav",
  "dur": 2.2058956916099772
 },
 {
  "text": "你给我的那些年，我全都带过来了。",
  "file": "line4.wav",
  "dur": 2.8676643990929707
 },
 {
  "text": "下辈子，我还要找到你。记得好好吃饭哦。",
  "file": "line5.wav",
  "dur": 3.413015873015873
 }
]